# ==============================================================================
# VERAND.BOT — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Salin file ini menjadi `.env.local` untuk konfigurasi lingkungan lokal Anda:
#   copy .env.example .env.local
# ==============================================================================

# 1. Kredensial Supabase (PostgreSQL Database, Auth, Realtime)
# Dapatkan dari: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here

# 2. Port Opsional untuk Aplikasi (Default: 3000)
# PORT=3000

# 3. Mode Worker (Opsional, diisi otomatis saat menjalankan npm run worker)
# IS_WORKER=true
